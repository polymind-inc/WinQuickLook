<Window
    x:Class="WinQuickLook.App.WinUI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="Root"
        Background="Transparent"
        IsTabStop="True"
        KeyDown="Root_KeyDown">
        <Grid
            x:Name="PreviewSurface"
            Padding="24,18,24,24"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PreviewSurfaceScale" ScaleX="0.96" ScaleY="0.96" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragRegion">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="PathText"
                        FontSize="11"
                        Opacity="0.68"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    x:Name="CounterText"
                    Grid.Column="1"
                    Margin="18,0,14,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.72" />
                <Button
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Glyph="&#xE711;" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid>
                    <ContentControl
                        x:Name="PrimaryContent"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                    <ContentControl
                        x:Name="SecondaryContent"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Opacity="0"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
